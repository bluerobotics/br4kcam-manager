  "actions": [
    {
      "id": "br4kcam_white_balance_all",
      "name": "4K Cam One-Push White Balance (All)",
      "type": "http-request",
      "config": {
        "name": "4K Cam One-Push White Balance (All)",
        "url": "http://{{ vehicle-address }}/extensionv2/4kcammanager/v1/camera/control",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "urlParams": {},
        "body": "{\"action\":\"setImageAdjustmentExAll\",\"json\":{\"onceAWB\":1}}"
      },
      "version": "1.0.1",
      "description": "Triggers one-push white balance on every configured 4K Cam."
    },
    {
      "id": "br4kcam_white_balance_5b1c6a6c-3f5e-4d1e-9a3f-8a7d0e2b1c34",
