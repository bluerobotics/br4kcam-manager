        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "urlParams": {},
        "body": "{\"action\":\"setImageAdjustmentEx\",\"camera_uuid\":\"5b1c6a6c-3f5e-4d1e-9a3f-8a7d0e2b1c34\",\"json\":{\"onceAWB\":1}}"
      },
      "version": "1.0.1",
      "description": "Triggers one-push white balance on 192.168.2.10 only."
    }
