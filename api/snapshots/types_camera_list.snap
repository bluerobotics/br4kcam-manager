export type Camera = {
    uuid: string,
    hostname: string,
    streams: { [key in string]?: Stream },
};

export type Stream = {
    name: string,
    source_endpoint: string,
    stream_endpoints: Array<string>,
    state: StreamStatusState,
    error: string | null,
    firmware_version: string,
};

export type StreamStatusState = "running" | "idle" | "stopped" | "unknown";
