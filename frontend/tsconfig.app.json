{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    // "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      // Pins every package's Vue types to this app's copy, matching the runtime dedupe in
      // vite.config.mts. Without it a dependency resolved through a symlink names its own Vue.
      "vue": ["./node_modules/vue"]
    },
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  }
}
