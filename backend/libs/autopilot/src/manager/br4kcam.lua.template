    assert(param:add_param(camera.param_table_key, 2, "GAIN", camera.margin_gain), 'could not add GAIN')

    -- Initialize parameter objects
    camera.ENABLE = Parameter()      -- when false, this bypasses the correlation
    camera.GAIN = Parameter() -- this will allow us to move 5% beyeond closest/furthest focus lines, useful for making a new curve

    -- Bind them to physical parameter locations
    assert(camera.ENABLE:init(camera.param_prefix .. "ENABLE"), "Failed to init ENABLE")
